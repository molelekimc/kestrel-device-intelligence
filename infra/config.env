# Settings shared by deploy.sh and teardown.sh. Edit before the first run.

PROJECT="ard-kestrel"                 # used in every resource name
ENVIRONMENT="dev"
LOCATION="southafricanorth"           # Johannesburg region
RESOURCE_GROUP="rg-${PROJECT}-${ENVIRONMENT}"

# Monthly budget, in your subscription's billing currency.
# Alerts go to ALERT_EMAIL at 80% of actual spend and 100% of forecast spend.
BUDGET_AMOUNT=500
ALERT_EMAIL=""                        # blank = the email you sign in to Azure with

# Set to "true" to upload ../raw into the bronze container at the end.
UPLOAD_RAW_DATA="true"
